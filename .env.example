# ---- Server-side only (set these in Netlify → Site configuration → Environment variables) ----

# Supabase project (Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role key — server only, never in the browser

# Google service account with read access to the sheet (share the sheet with its client_email).
# Paste the JSON key either raw or base64-encoded.
GOOGLE_SERVICE_ACCOUNT_JSON=

# The spreadsheet to read (the ID from the sheet URL)
SHEET_ID=1vUh-9oDKVtijuhQLsihm7SGCBDT7PhSSbrvvkElyQrg
DB_SHEET=DB
HELPER_SHEET=Helper - Raw
RAW_SHEET=Raw data
DIRECTORY_SHEETS=Employee Data,Resigned,Sheet12,DB-BDMs

# Shared secret that protects the sync endpoints (any long random string)
SYNC_SECRET=change-me-to-a-long-random-string

# Key required to download call-level archives (defaults to SYNC_SECRET when unset)
DOWNLOAD_KEY=

# icku HR directory (optional): team mapping from view da.employee_directory with a read-only login.
# When set, managers / titles / status come from here instead of the Employee Data tab.
ICKU_DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
ICKU_DB_PORT=5432
ICKU_DB_NAME=postgres
ICKU_DB_USER=
ICKU_DB_PASSWORD=
ICKU_DB_SCHEMA=da
# PEM certificate of the database's CA for verify-full (optional; without it the connection is encrypted but unverified)
ICKU_DB_SSL_CA=

# Seconds the /api/data response may be cached (2–5 minutes recommended)
CACHE_SECONDS=180

# ---- Local development only ----
# Path to an .xlsx export of the sheet; lets `npm run dev:api -- --workbook` run without Google/Supabase.
WORKBOOK_PATH=
